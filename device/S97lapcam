#!/bin/sh
# Start/stop lapcam (docs/lapcam.md): the phone-first web app of this repo that
# replaces Thingino's web UI (preview, YouTube stream, OSD, SD recording,
# Wi-Fi). The binary lives on the SD card:
#   /mnt/mmcblk0p1/lapcam        (built with device/lapcam/build.sh)
#   /mnt/mmcblk0p1/lapcam.args   (one line of options; install-lapcam.sh writes
#                                "-listen :80")
# With "-listen :80" this script stops Thingino's web server uhttpd (S60uhttpd,
# ports 80/443) right before starting the app, and starts uhttpd again when the
# app is stopped. uhttpd itself stays enabled: a camera without the SD card or
# the binary keeps Thingino's UI instead of having none.
# Runs in portal / access point mode too: it is the only UI then.
# Install to /etc/init.d/S97lapcam (chmod +x). service enable/disable lapcam.

DAEMON="lapcam"
SD="/mnt/mmcblk0p1"
DAEMON_PATH="$SD/lapcam"
ARGS_FILE="$SD/lapcam.args"
PIDFILE="/run/$DAEMON.pid"

# takes_port_80 <args> - does the app serve on port 80 (uhttpd's port)?
takes_port_80() {
	case " $1 " in
		*" -listen :80 "* | *" -listen 0.0.0.0:80 "* | *" -listen [::]:80 "*) return 0 ;;
	esac
	return 1
}

running() {
	[ -f "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null)
	[ -n "$pid" ] || return 1
	grep -q "$DAEMON_PATH" "/proc/$pid/cmdline" 2>/dev/null
}

start() {
	echo -n "Starting $DAEMON: "
	if [ ! -x "$DAEMON_PATH" ]; then
		echo "SKIP (no $DAEMON_PATH)"
		return 0
	fi
	if running; then
		echo "SKIP (already running, pid $(cat $PIDFILE))"
		return 0
	fi
	rm -f "$PIDFILE"
	args=""
	[ -f "$ARGS_FILE" ] && args=$(head -n 1 "$ARGS_FILE" | tr -d '\r')
	if takes_port_80 "$args" && [ -f /etc/init.d/S60uhttpd ]; then
		# Thingino's UI makes room; it comes back if this app stops
		sh /etc/init.d/S60uhttpd stop >/dev/null 2>&1
		i=0
		while netstat -lnt 2>/dev/null | grep -q ':80 ' && [ $i -lt 10 ]; do
			sleep 1
			i=$((i + 1))
		done
		if netstat -lnt 2>/dev/null | grep -q ':80 '; then
			# the app could not bind: better Thingino's UI than none
			sh /etc/init.d/S60uhttpd start >/dev/null 2>&1
			echo "FAIL (port 80 still in use after 10 s; uhttpd started again)"
			return 1
		fi
	fi
	# -N 5: below prudynt/ISP, above nothing important. -syslog: logread | grep lapcam
	# shellcheck disable=SC2086
	if start-stop-daemon -S -b -m -N 5 -p "$PIDFILE" -x "$DAEMON_PATH" -- -syslog $args; then
		echo "OK"
	else
		echo "FAIL"
		return 1
	fi
}

stop() {
	echo -n "Stopping $DAEMON: "
	if ! running; then
		echo "SKIP (not running)"
		rm -f "$PIDFILE"
		return 0
	fi
	pid=$(cat "$PIDFILE")
	if ! start-stop-daemon -K -p "$PIDFILE" -s TERM 2>/dev/null && [ -d "/proc/$pid" ]; then
		echo "FAIL (could not signal pid $pid)"
		return 1
	fi
	i=0
	while [ -d "/proc/$pid" ] && [ $i -lt 50 ]; do
		usleep 100000
		i=$((i + 1))
	done
	if [ -d "/proc/$pid" ]; then
		echo "FAIL (pid $pid still running after 5 s)"
		return 1
	fi
	echo "OK"
	rm -f "$PIDFILE"
	args=""
	[ -f "$ARGS_FILE" ] && args=$(head -n 1 "$ARGS_FILE" | tr -d '\r')
	if takes_port_80 "$args" && [ -x /etc/init.d/S60uhttpd ] && [ ! -f /run/lapcam-restarting ]; then
		sh /etc/init.d/S60uhttpd start >/dev/null 2>&1 # Thingino's UI is back
	fi
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart)
		touch /run/lapcam-restarting # no uhttpd in between
		stop || { rm -f /run/lapcam-restarting; exit 1; }
		rm -f /run/lapcam-restarting
		start
		;;
	status)
		if running; then
			echo "$DAEMON is running (pid $(cat $PIDFILE))"
		else
			echo "$DAEMON is not running"
			exit 1
		fi
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac
