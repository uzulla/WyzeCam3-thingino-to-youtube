#!/bin/sh
# osd-config - keep prudynt's OSD settings in sync with a config file (SD card first)
# Install to /usr/sbin/osd-config (chmod +x). Started by /etc/init.d/S93osd-config.
#
# Settings changed with "prudyntctl json" live only in the running prudynt: they are
# gone after a prudynt restart or a reboot. This sends them again whenever needed,
# without writing prudynt's own config to flash (no save_config) - with one
# exception, "general.osd_pool_size", see below.
#
# Config search order (first match wins):
#   /mnt/mmcblk0p1/prudynt-osd.json   (SD card)
#   /etc/prudynt-osd.json             (built-in)
# The file is what you would pass to "prudyntctl json", e.g.
#   {"osd":{"textfile":{"enabled":true,"rows":10},"textfile2":{"enabled":true}}}
# Only its "osd" section is sent; anything else in the file is ignored, except:
#
#   {"general":{"osd_pool_size":2048}, "osd":{...}}
#
# The OSD pool (KB, 0 = prudynt's default) is only allocated when prudynt starts,
# so it cannot be sent at runtime. When the file names a size that differs from
# /etc/prudynt.json, it is written there with jct (the one write to flash this
# script does; same as the manual procedure in docs/osd.md) and prudynt is
# restarted (the stream drops for a few seconds). Nothing happens while the two
# agree, so this is normally a one-off. The value stays when the file goes away
# (it only reserves memory, it shows nothing); write 0 to go back to the default.
# If prudynt does not come back up with the new size, the old one is restored.
#
# Re-sent when prudynt was restarted (new pid) or the file changed / appeared /
# moved (SD inserted). File gone (SD pulled), or a text overlay block removed from
# it -> the text overlays it had turned on are turned off again; slots it never
# mentioned are not touched. No config file
# ever seen -> prudynt is left alone.

CONFIG_CANDIDATES=${OSD_CONFIG_CANDIDATES:-"/mnt/mmcblk0p1/prudynt-osd.json /etc/prudynt-osd.json"}
POLL=${OSD_CONFIG_POLL:-5}
TAG="osd-config"

log() {
	logger -p daemon.info -t $TAG "$1"
}

find_config() {
	for c in $CONFIG_CANDIDATES; do
		if [ -f "$c" ]; then
			echo "$c"
			return 0
		fi
	done
	return 1
}

# send <osd-object-json> - returns 0 when prudynt took it. prudynt answers an osd
# request with the current values of the sections it was given ({"textfile":{...}});
# no socket yet, or nothing it understood, gives an empty answer or {}.
send() {
	case $(prudyntctl json "{\"osd\":$1}" 2>/dev/null) in
	"" | "{}"*) return 1 ;;
	"{"*) return 0 ;;
	esac
	return 1
}

# Slots (textfile, textfile2, textfile3) that the config file mentions: only those
# are ours to turn off again when the file goes away.
slots_in() {
	for slot in textfile textfile2 textfile3; do
		case $(jct "$1" get "osd.$slot" 2>/dev/null) in "{"*) printf '%s ' "$slot" ;; esac
	done
}

# off_json <slots> - {"textfile":{"enabled":false},...}
off_json() {
	j=""
	for slot in $1; do
		j="$j${j:+,}\"$slot\":{\"enabled\":false}"
	done
	echo "{$j}"
}

# What the running prudynt has been sent. Kept on tmpfs so that restarting this
# script alone does not forget which overlays it turned on (a reboot or a prudynt
# restart resets prudynt anyway, and the pid in "applied" then no longer matches).
STATE=/run/osd-config.state
applied=""  # "pid|file|checksum" of the config applied to the running prudynt
managed=""  # text slots turned on by it
[ -f "$STATE" ] && . "$STATE"
save_state() {
	printf 'applied="%s"\nmanaged="%s"\n' "$applied" "$managed" >"$STATE"
}

complained="" # last problem reported, so each one is logged once
fails=0

# Values above what a T31 with 720p streams could reserve (32768 does not start,
# 16384 does; docs/osd.md) are refused rather than tried.
POOL_MAX=16384
PRUDYNT_CONFIG=/etc/prudynt.json
PRUDYNT_INIT=/etc/init.d/S31prudynt

prudynt_up() {
	case $(prudyntctl json '{"general":{"loglevel":null}}' 2>/dev/null) in
	"{"*) return 0 ;;
	esac
	return 1
}

# restart_prudynt - 0 once the new prudynt answers, 1 if it died or does not
# answer within 30 s, 2 if the old one would not stop (nothing was restarted then). "S31prudynt stop" (and so its
# restart) can return before prudynt is gone, and the new one then quits with
# "Another Prudynt instance appears to be running": wait for the old one ourselves.
restart_prudynt() {
	"$PRUDYNT_INIT" stop >/dev/null 2>&1
	i=0
	while pidof prudynt >/dev/null && [ $i -lt 20 ]; do
		sleep 1
		i=$((i + 1))
	done
	pidof prudynt >/dev/null && return 2
	"$PRUDYNT_INIT" start >/dev/null 2>&1
	i=0
	while [ $i -lt 30 ]; do
		sleep 1
		prudynt_up && return 0
		[ $i -ge 5 ] && [ -z "$(pidof prudynt)" ] && return 1
		i=$((i + 1))
	done
	# Alive but silent after 30 s (normal start-up is a few seconds): failure,
	# the caller goes back to the old size rather than trusting it.
	return 1
}

# apply_pool <cfg> - general.osd_pool_size from the config file into
# /etc/prudynt.json + prudynt restart, when they differ. Returns 0 when prudynt
# was restarted (the caller then starts over with the new pid).
pool_bad="" # "file:value" refused or failed, not tried again until it changes
apply_pool() {
	raw=$(jct "$1" get general.osd_pool_size 2>/dev/null) || return 1
	[ "$1:$raw" = "$pool_bad" ] && return 1
	want=$raw
	case "$want" in
	"" | *[!0-9]*) want="" ;;
	*) [ "$want" -le "$POOL_MAX" ] || want="" ;;
	esac
	if [ -z "$want" ]; then
		log "general.osd_pool_size in $1 must be 0..$POOL_MAX (KB), got \"$raw\" - ignored"
		pool_bad="$1:$raw"
		return 1
	fi
	have=$(jct "$PRUDYNT_CONFIG" get general.osd_pool_size 2>/dev/null) || have=0
	[ "$want" = "$have" ] && return 1
	# Read back what was written: if it does not match, do not restart, and do
	# not try again (that would write flash on every pass).
	if ! jct "$PRUDYNT_CONFIG" set general.osd_pool_size "$want" >/dev/null 2>&1 ||
		[ "$(jct "$PRUDYNT_CONFIG" get general.osd_pool_size 2>/dev/null)" != "$want" ]; then
		log "cannot write general.osd_pool_size=$want to $PRUDYNT_CONFIG"
		pool_bad="$1:$raw"
		return 1
	fi
	log "general.osd_pool_size $have -> $want KB in $PRUDYNT_CONFIG (from $1) - restarting prudynt"
	restart_prudynt
	case $? in
	0) return 0 ;;
	2)
		# Old prudynt still running with the old size; the new one is in flash
		# and applies whenever prudynt next restarts.
		log "prudynt did not stop - osd_pool_size=$want applies at its next restart"
		pool_bad="$1:$raw"
		return 1
		;;
	esac
	jct "$PRUDYNT_CONFIG" set general.osd_pool_size "$have" >/dev/null 2>&1
	log "prudynt did not come up with osd_pool_size=$want - restored $have"
	restart_prudynt || log "prudynt is still not running after restoring osd_pool_size=$have"
	pool_bad="$1:$raw"
	return 0
}

while :; do
	pid=$(pidof prudynt | cut -d' ' -f1)
	if [ -z "$pid" ]; then
		sleep "$POLL"
		continue
	fi
	# A new prudynt starts from its own config: nothing of ours is on any more
	case "$applied" in "$pid|"*) ;; *) managed="" ;; esac

	if cfg=$(find_config); then
		apply_pool "$cfg" && continue
		body=$(jct "$cfg" get osd 2>/dev/null)
		case "$body" in
		"{"*)
			want="$pid|$cfg|$(printf '%s' "$body" | md5sum | cut -d' ' -f1)"
			# Slots we turned on earlier that the new config no longer mentions
			# (other file took over, or the block was deleted): off first, and
			# only then forget them. If that fails, keep "managed" and retry.
			new_slots=$(slots_in "$cfg")
			stale=""
			for slot in $managed; do
				case " $new_slots" in *" $slot "*) ;; *) stale="$stale$slot " ;; esac
			done
			if [ "$want" = "$applied" ]; then
				complained=""
			elif { [ -z "$stale" ] || send "$(off_json "$stale")"; } && send "$body"; then
				log "Applied $cfg to prudynt (pid $pid)${stale:+, turned off: $stale}"
				applied=$want
				managed=$new_slots
				save_state
				complained=""
				fails=0
			else
				# Normal for a few seconds while prudynt starts up. If it goes on,
				# prudynt understood nothing in the file (misspelled keys, or a
				# prudynt without the OSD patch).
				fails=$((fails + 1))
				if [ $fails -ge 6 ] && [ "$complained" != "send:$want" ]; then
					log "prudynt does not accept the osd settings in $cfg - still retrying"
					complained="send:$want"
				fi
			fi
			;;
		*)
			# Broken JSON or no "osd" object. If it is the file we applied that got
			# broken (a typo while editing), change nothing. If a different file
			# took over (SD pulled, and the built-in one is unusable), what the
			# old file had turned on must not stay: off, as if no file was left.
			case "$applied" in
			"$pid|$cfg|"*) ;;
			*)
				if [ -n "$managed" ] && send "$(off_json "$managed")"; then
					log "Config changed to $cfg - turned off: $managed"
					applied="$pid|none"
					managed=""
					save_state
				fi
				;;
			esac
			if [ "$complained" != "parse:$cfg" ]; then
				log "$cfg has no usable \"osd\" object - ignored"
				complained="parse:$cfg"
			fi
			;;
		esac
	elif [ -n "$managed" ] && send "$(off_json "$managed")"; then
		log "Config file is gone - turned off: $managed"
		applied="$pid|none"
		managed=""
		save_state
	fi
	sleep "$POLL"
done
