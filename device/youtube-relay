#!/bin/sh
# youtube-relay - supervise the ffmpeg RTSP -> RTMPS relay to YouTube Live
# Install to /usr/sbin/youtube-relay (chmod +x). Started by /etc/init.d/S93youtube-relay.
#
# Config search order (first match wins):
#   /mnt/mmcblk0p1/youtube-relay.json   (SD card - standalone/portable mode)
#   /etc/youtube-relay.json             (built-in, chmod 600)
# No usable config -> stand by and keep polling. Config removed while
# streaming (e.g. SD card pulled) -> stop the stream and stand by.

CONFIG_CANDIDATES="/mnt/mmcblk0p1/youtube-relay.json /etc/youtube-relay.json"
TAG="youtube-relay"

log() {
	logger -p daemon.info -t $TAG "$1"
}

find_config() {
	for c in $CONFIG_CANDIDATES; do
		if [ -f "$c" ]; then
			echo "$c"
			return 0
		fi
	done
	return 1
}

# Usable = file exists, not explicitly disabled, has a stream key
config_ok() {
	[ -f "$1" ] || return 1
	[ "$(jct "$1" get enabled 2>/dev/null)" = "false" ] && return 1
	[ -n "$(jct "$1" get stream_key 2>/dev/null)" ]
}

# Network is considered up when a default route exists. Deliberately no
# gateway ping: routers that drop ICMP would wedge this gate forever, while
# a stale route just makes ffmpeg fail fast and retry (max 10s loop).
network_ready() {
	[ -n "$(ip -4 route show default 2>/dev/null)" ]
}

# Only use a binary that runs on this firmware and can speak the output
# protocol. Catches a build for another toolchain generation left on the SD
# card after an upgrade, and Thingino's own recording-only ffmpeg (no RTMPS;
# present only in images built with BR2_PACKAGE_PRUDYNT_T_FFMPEG).
ffmpeg_supports() {
	"$1" -hide_banner -protocols 2>/dev/null | awk -v proto="$2" '
		$0 == "Output:" { out = 1; next }
		out && $1 == proto { found = 1 }
		END { exit !found }'
}

# ffmpeg's stderr -> syslog, so "why did it exit" is answered by logread.
# Reads stdin; $1 = 1 for a diagnostic (-loglevel debug) run, where only the
# connection-level lines are kept (debug prints ~100 lines per start).
# - the stream key and RTSP credentials never reach the log
# - at most FFMPEG_LOG_MAX lines (plus a notice) per ffmpeg run; the rest is read and dropped
#   (never stop reading: ffmpeg would die of SIGPIPE, or block on a full pipe)
FFMPEG_LOG_MAX=60
ffmpeg_log() {
	SECRET="$STREAM_KEY" awk -v diag="$1" -v max="$FFMPEG_LOG_MAX" '
		n > max { next }
		diag && $0 !~ /^\[(rtmps?|tls|tcp)[^]]*\] |rror|ailed|End of file/ { next }
		diag && / Address |list of addresses|whitelist|parse interval|update header/ { next }
		{
			# Search on past each replacement: a key like "RED" would
			# otherwise match the marker itself forever
			k = ENVIRON["SECRET"]
			if (k != "") {
				s = $0
				$0 = ""
				while ((i = index(s, k)) > 0) {
					$0 = $0 substr(s, 1, i - 1) "REDACTED"
					s = substr(s, i + length(k))
				}
				$0 = $0 s
			}
			gsub(/:\/\/[^@\/ ]*@/, "://REDACTED@")
			sub(/Authorization: .*/, "Authorization: REDACTED") # RTSP, at trace level
			if (++n > max)
				$0 = "(more output suppressed)"
			print "ffmpeg: " $0
			fflush()
		}' | logger -p daemon.warning -t $TAG
}

FIFO="/run/$TAG.stderr"
FFMPEG_PID=""
WATCHER_PID=""
LOG_PID=""

cleanup() {
	[ -n "$WATCHER_PID" ] && kill "$WATCHER_PID" 2>/dev/null
	if [ -n "$FFMPEG_PID" ]; then
		kill "$FFMPEG_PID" 2>/dev/null
		i=0
		while kill -0 "$FFMPEG_PID" 2>/dev/null && [ $i -lt 5 ]; do
			i=$((i + 1))
			sleep 1
		done
		kill -9 "$FFMPEG_PID" 2>/dev/null
		wait "$FFMPEG_PID" 2>/dev/null
	fi
	[ -n "$LOG_PID" ] && kill "$LOG_PID" 2>/dev/null
	rm -f "$FIFO"
	log "Stopped"
	exit 0
}
trap cleanup TERM INT

log "Started, watching for config: $CONFIG_CANDIDATES"

# Wait for network once, then give NTP up to 60s to sync (nice-to-have for TLS)
network_ready || log "Waiting for network"
until network_ready; do
	sleep 5
done
n=0
while [ ! -f /run/sync_success ] && [ $n -lt 12 ]; do
	n=$((n + 1))
	sleep 5
done

BACKOFF=2
STANDBY_LOGGED=0
NET_LOGGED=0
FFMPEG_LOGGED=0
# DIAG=1: run the next ffmpeg with -loglevel debug. Set once per streak of
# quick failures (DIAG_DONE), because "Error opening output: Input/output
# error" alone does not tell a network/TLS problem from YouTube refusing the
# publish. Once only: retrying every 10s at debug would flood the syslog ring.
DIAG=0
DIAG_DONE=0
while true; do
	CFG=$(find_config)
	if [ -z "$CFG" ] || ! config_ok "$CFG"; then
		if [ $STANDBY_LOGGED -eq 0 ]; then
			log "No usable config, standing by"
			STANDBY_LOGGED=1
			BACKOFF=2
		fi
		# A config that comes back later (other SD card, new key) is a new story
		DIAG=0
		DIAG_DONE=0
		sleep 10
		continue
	fi
	STANDBY_LOGGED=0

	RTSP_URL=$(jct "$CFG" get rtsp_url 2>/dev/null)
	[ -n "$RTSP_URL" ] || RTSP_URL="rtsp://thingino:thingino@127.0.0.1:554/ch0"
	RTMP_URL=$(jct "$CFG" get rtmp_url 2>/dev/null)
	[ -n "$RTMP_URL" ] || RTMP_URL="rtmps://a.rtmps.youtube.com:443/live2"
	STREAM_KEY=$(jct "$CFG" get stream_key 2>/dev/null)
	# ffmpeg_opts go before -i (input options, e.g. -timeout), ffmpeg_out_opts
	# after it (output options, e.g. -map). ffmpeg rejects them in the wrong spot.
	FFMPEG_OPTS=$(jct "$CFG" get ffmpeg_opts 2>/dev/null)
	FFMPEG_OUT_OPTS=$(jct "$CFG" get ffmpeg_out_opts 2>/dev/null)
	LOGLEVEL=$(jct "$CFG" get ffmpeg_loglevel 2>/dev/null)
	[ -n "$LOGLEVEL" ] || LOGLEVEL="error"

	# Search order: temporary/removable locations first so a test binary on
	# the SD card or in /tmp overrides the installed one; reboot (or pulling
	# the SD card) falls back to the installed binary automatically.
	PROTO=${RTMP_URL%%:*}
	FFMPEG=$(jct "$CFG" get ffmpeg_bin 2>/dev/null)
	# An explicit ffmpeg_bin wins, but if it is unusable (typically
	# /usr/bin/ffmpeg wiped with the overlay by an upgrade) fall back to
	# the search so an SD card binary can still bring the stream up.
	if [ -n "$FFMPEG" ] && { [ ! -x "$FFMPEG" ] || ! ffmpeg_supports "$FFMPEG" "$PROTO"; }; then
		FFMPEG=""
	fi
	if [ -z "$FFMPEG" ]; then
		for f in /mnt/mmcblk0p1/ffmpeg /tmp/ffmpeg /usr/bin/ffmpeg /usr/local/bin/ffmpeg; do
			[ -x "$f" ] && ffmpeg_supports "$f" "$PROTO" && FFMPEG="$f" && break
		done
	fi
	if [ ! -x "$FFMPEG" ]; then
		if [ $FFMPEG_LOGGED -eq 0 ]; then
			log "No ffmpeg binary with $PROTO support found, standing by"
			FFMPEG_LOGGED=1
		fi
		DIAG=0
		sleep 30
		continue
	fi
	FFMPEG_LOGGED=0

	if ! network_ready; then
		if [ $NET_LOGGED -eq 0 ]; then
			log "Network down (no default route), waiting"
			NET_LOGGED=1
		fi
		DIAG=0 # whatever failed before, the cause is known now
		sleep 5
		continue
	fi
	NET_LOGGED=0

	if [ $DIAG -eq 1 ]; then
		LOGLEVEL="debug"
		log "Starting ffmpeg -> $RTMP_URL/REDACTED (config: $CFG, ffmpeg: $FFMPEG, loglevel debug to diagnose the failure)"
	else
		log "Starting ffmpeg -> $RTMP_URL/REDACTED (config: $CFG, ffmpeg: $FFMPEG)"
	fi

	START=$(date +%s)
	set -f
	# -nostats: from loglevel info up, ffmpeg prints a progress line ending in
	# \r, not \n. awk would buffer that as one ever-growing record.
	set -- -nostdin -hide_banner -nostats -loglevel "$LOGLEVEL" -rtsp_transport tcp $FFMPEG_OPTS \
		-i "$RTSP_URL" -c copy $FFMPEG_OUT_OPTS -f flv "$RTMP_URL/$STREAM_KEY"
	set +f
	# stderr goes through a FIFO rather than "ffmpeg | ffmpeg_log": $! and the
	# exit code must stay ffmpeg's own
	rm -f "$FIFO"
	if mkfifo -m 600 "$FIFO" 2>/dev/null; then
		ffmpeg_log $DIAG <"$FIFO" &
		LOG_PID=$!
		"$FFMPEG" "$@" 2>"$FIFO" &
	else
		log "mkfifo $FIFO failed, ffmpeg output will not be logged"
		LOG_PID=""
		"$FFMPEG" "$@" &
	fi
	FFMPEG_PID=$!
	DIAG=0

	# Watcher: stop the stream if its config disappears (SD pulled) or is disabled
	(
		while kill -0 $FFMPEG_PID 2>/dev/null; do
			if ! config_ok "$CFG"; then
				log "Config removed or disabled, stopping stream"
				kill $FFMPEG_PID 2>/dev/null
				exit 0
			fi
			sleep 15
		done
	) &
	WATCHER_PID=$!

	wait $FFMPEG_PID
	RC=$?
	FFMPEG_PID=""
	# Let the last stderr lines reach syslog before our own "exited" line.
	# It ends on EOF right after ffmpeg; the timer only keeps a wedged logger
	# from blocking the restart.
	if [ -n "$LOG_PID" ]; then
		(sleep 5 && kill $LOG_PID 2>/dev/null) &
		TIMER_PID=$!
		wait $LOG_PID 2>/dev/null
		kill $TIMER_PID 2>/dev/null
		wait $TIMER_PID 2>/dev/null
		LOG_PID=""
	fi
	kill $WATCHER_PID 2>/dev/null
	wait $WATCHER_PID 2>/dev/null
	WATCHER_PID=""
	DUR=$(($(date +%s) - START))

	# If the config is gone, go straight back to standby without backoff noise
	config_ok "$CFG" || continue

	# Healthy run -> restart quickly; consecutive quick failures -> grow up to 10s
	if [ $DUR -ge 60 ]; then
		BACKOFF=2
		DIAG_DONE=0
	else
		BACKOFF=$((BACKOFF * 2))
		[ $BACKOFF -gt 10 ] && BACKOFF=10
		if [ $DIAG_DONE -eq 0 ]; then
			DIAG=1
			DIAG_DONE=1
		fi
	fi
	log "ffmpeg exited (rc=$RC) after ${DUR}s, restarting in ${BACKOFF}s"
	sleep $BACKOFF
done
