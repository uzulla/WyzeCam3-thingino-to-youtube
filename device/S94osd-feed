#!/bin/sh
# Start/stop osd-feed (docs/osd-feed.md): the program that writes the OSD text
# overlays. Binary and configuration live on the SD card:
#   /mnt/mmcblk0p1/osd-feed        (built with device/osd-feed/build.sh)
#   /mnt/mmcblk0p1/osd-feed.json   (see device/osd-feed/osd-feed.json.example)
# Nothing starts when either is missing, so a camera without them is unchanged.
# Install to /etc/init.d/S94osd-feed (chmod +x). service enable/disable osd-feed.

DAEMON="osd-feed"
SD="/mnt/mmcblk0p1"
DAEMON_PATH="$SD/osd-feed"
CONFIG="$SD/osd-feed.json"
PIDFILE="/run/$DAEMON.pid"

running() {
	[ -f "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null)
	[ -n "$pid" ] || return 1
	grep -q "$DAEMON_PATH" "/proc/$pid/cmdline" 2>/dev/null
}

start() {
	echo -n "Starting $DAEMON: "
	if [ -f /run/portal_mode ]; then
		echo "SKIP (portal mode)"
		exit 0
	fi
	if [ ! -x "$DAEMON_PATH" ] || [ ! -f "$CONFIG" ]; then
		echo "SKIP (no $DAEMON_PATH or $CONFIG)"
		exit 0
	fi
	if running; then
		echo "SKIP (already running, pid $(cat $PIDFILE))"
		exit 0
	fi
	rm -f "$PIDFILE"
	# -N 10: lower priority, prudynt/ISP come first. -syslog: messages go to
	# logread (logread | grep osd-feed)
	if start-stop-daemon -S -b -m -N 10 -p "$PIDFILE" -x "$DAEMON_PATH" -- -syslog; then
		echo "OK"
	else
		echo "FAIL"
		exit 1
	fi
}

stop() {
	echo -n "Stopping $DAEMON: "
	if ! running; then
		echo "SKIP (not running)"
		rm -f "$PIDFILE"
		return 0
	fi
	if start-stop-daemon -K -p "$PIDFILE" -s TERM 2>/dev/null; then
		echo "OK"
	else
		echo "FAIL (not running?)"
	fi
	rm -f "$PIDFILE"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart)
		stop
		sleep 1
		start
		;;
	status)
		if running; then
			echo "$DAEMON is running (pid $(cat $PIDFILE))"
		else
			echo "$DAEMON is not running"
			exit 1
		fi
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac
