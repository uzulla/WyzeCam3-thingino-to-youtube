#!/bin/sh
# Start/stop webui (docs/webui.md): the phone-first web app of this repo that
# replaces Thingino's web UI (preview, YouTube stream, OSD, SD recording,
# Wi-Fi). The binary lives on the SD card:
#   /mnt/mmcblk0p1/webui        (built with device/webui/build.sh)
#   /mnt/mmcblk0p1/webui.args   (one line of options; install-webui.sh writes
#                                "-listen :80" and disables uhttpd, Thingino's
#                                web server, so the app answers on the plain IP)
# Nothing starts without the binary, so a camera without it is unchanged.
# Runs in portal / access point mode too: it is the only UI then.
# Install to /etc/init.d/S97webui (chmod +x). service enable/disable webui.

DAEMON="webui"
SD="/mnt/mmcblk0p1"
DAEMON_PATH="$SD/webui"
ARGS_FILE="$SD/webui.args"
PIDFILE="/run/$DAEMON.pid"

running() {
	[ -f "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null)
	[ -n "$pid" ] || return 1
	grep -q "$DAEMON_PATH" "/proc/$pid/cmdline" 2>/dev/null
}

start() {
	echo -n "Starting $DAEMON: "
	if [ ! -x "$DAEMON_PATH" ]; then
		echo "SKIP (no $DAEMON_PATH)"
		return 0
	fi
	if running; then
		echo "SKIP (already running, pid $(cat $PIDFILE))"
		return 0
	fi
	rm -f "$PIDFILE"
	args=""
	[ -f "$ARGS_FILE" ] && args=$(head -n 1 "$ARGS_FILE" | tr -d '\r')
	# -N 5: below prudynt/ISP, above nothing important. -syslog: logread | grep webui
	# shellcheck disable=SC2086
	if start-stop-daemon -S -b -m -N 5 -p "$PIDFILE" -x "$DAEMON_PATH" -- -syslog $args; then
		echo "OK"
	else
		echo "FAIL"
		return 1
	fi
}

stop() {
	echo -n "Stopping $DAEMON: "
	if ! running; then
		echo "SKIP (not running)"
		rm -f "$PIDFILE"
		return 0
	fi
	pid=$(cat "$PIDFILE")
	if ! start-stop-daemon -K -p "$PIDFILE" -s TERM 2>/dev/null && [ -d "/proc/$pid" ]; then
		echo "FAIL (could not signal pid $pid)"
		return 1
	fi
	i=0
	while [ -d "/proc/$pid" ] && [ $i -lt 50 ]; do
		usleep 100000
		i=$((i + 1))
	done
	if [ -d "/proc/$pid" ]; then
		echo "FAIL (pid $pid still running after 5 s)"
		return 1
	fi
	echo "OK"
	rm -f "$PIDFILE"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart)
		stop || exit 1
		start
		;;
	status)
		if running; then
			echo "$DAEMON is running (pid $(cat $PIDFILE))"
		else
			echo "$DAEMON is not running"
			exit 1
		fi
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac
