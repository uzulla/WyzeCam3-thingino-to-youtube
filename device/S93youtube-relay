#!/bin/sh
# Start/stop the YouTube Live relay supervisor.
# Install to /etc/init.d/S93youtube-relay (chmod +x).
# Enable/disable with: service enable youtube-relay / service disable youtube-relay
# (or set "enabled": false in /etc/youtube-relay.json)

DAEMON="youtube-relay"
DAEMON_PATH="/usr/sbin/youtube-relay"
PIDFILE="/run/$DAEMON.pid"

running() {
	[ -f "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null)
	[ -n "$pid" ] || return 1
	# Verify the PID is alive and actually is our supervisor, not a reused PID
	grep -q "$DAEMON" "/proc/$pid/cmdline" 2>/dev/null
}

start() {
	echo -n "Starting $DAEMON: "
	if [ -f /run/portal_mode ]; then
		echo "SKIP (portal mode)"
		exit 0
	fi
	# No config check here: the supervisor stands by until a usable config
	# appears on the SD card (/mnt/mmcblk0p1) or in /etc, so an SD card
	# inserted later starts streaming automatically.
	if running; then
		echo "SKIP (already running, pid $(cat $PIDFILE))"
		exit 0
	fi
	rm -f "$PIDFILE"
	# -N 10: lower priority so we never compete with prudynt/ISP
	if start-stop-daemon -S -b -m -N 10 -p "$PIDFILE" -x "$DAEMON_PATH"; then
		echo "OK"
	else
		echo "FAIL"
		exit 1
	fi
}

# stop - TERM, then wait for the supervisor to be gone. TERM only asks: it
# exits after its current sleep and after reaping ffmpeg (up to ~15 s). A
# "restart" that did not wait would run a new supervisor alongside the old
# one, both publishing to the same stream key. After 45 s it is killed.
stop() {
	echo -n "Stopping $DAEMON: "
	# A stale pidfile may name a PID since reused by something else: never signal that
	if ! running; then
		echo "SKIP (not running)"
		rm -f "$PIDFILE"
		return 0
	fi
	pid=$(cat "$PIDFILE")
	if ! start-stop-daemon -K -p "$PIDFILE" -s TERM 2>/dev/null; then
		echo "FAIL (could not signal pid $pid)"
		return 1
	fi
	i=0
	while grep -q "$DAEMON" "/proc/$pid/cmdline" 2>/dev/null && [ $i -lt 45 ]; do
		sleep 1
		i=$((i + 1))
	done
	if grep -q "$DAEMON" "/proc/$pid/cmdline" 2>/dev/null; then
		echo -n "(did not exit, killing) "
		pkill -KILL -P "$pid" 2>/dev/null # its ffmpeg first, or it would be orphaned
		kill -9 "$pid" 2>/dev/null
		i=0
		while grep -q "$DAEMON" "/proc/$pid/cmdline" 2>/dev/null && [ $i -lt 5 ]; do
			sleep 1
			i=$((i + 1))
		done
		if grep -q "$DAEMON" "/proc/$pid/cmdline" 2>/dev/null; then
			echo "FAIL (pid $pid will not die)"
			return 1
		fi
	fi
	echo "OK"
	rm -f "$PIDFILE"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop || exit 1
		start
		;;
	status)
		if running; then
			echo "$DAEMON is running (pid $(cat $PIDFILE))"
		else
			echo "$DAEMON is not running"
			exit 1
		fi
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac
