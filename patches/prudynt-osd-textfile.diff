index 0000000..976fbd0
--- /dev/null
+++ b/src/video/OSDImagefile.cpp
@@ -0,0 +1,300 @@
+// -- image overlay --------------------------------------------------------
+// One burned-in OSD region (osd.imagefile) showing a raw BGRA bitmap read
+// from a file (the slot's path, meant to live on tmpfs): exactly
+// width x height x 4 bytes, no header, B G R A per pixel, straight (not
+// premultiplied) alpha. Whoever writes the file does the decoding (PNG ->
+// BGRA; see device/osd-feed) - there is no image library in here.
+//
+// Same contract as the text overlays (OSDTextfile.cpp): replace the file with
+// rename(2), and this code notices on the next OSD thread tick (100 ms). A
+// missing or empty file hides the region; a file of the wrong size is
+// reported once and not shown (it is a writer bug, and half a picture would
+// only hide it). The region is laid out after the text slots, from what they
+// left of the OSD pool, and is never shrunk: a picture either fits or is not
+// shown. It is given up BEFORE the text slots grow (release_only pass) so
+// that their IMP_OSD_SetRgnAttr() finds the room the planner promised them -
+// libimp does not report a region that does not fit, it just never shows.
+
+#ifdef OSD_BURN_TIMESTAMP
+
+#include "video/OSD.hpp"
+#include "config/Config.hpp"
+#include "util/Logger.hpp"
+#include <algorithm>
+#include <cerrno>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace {
+
+// pos >= 0: distance of the region's near edge from the left/top.
+// pos <  0: distance of the region's far edge from the right/bottom.
+// Clamped into the frame and rounded down to an even pixel (as the text slots).
+int resolveImagePos(int pos, int size, int frame) {
+  int p = pos >= 0 ? pos : frame + pos - size;
+  p = std::clamp(p, 0, std::max(0, frame - size));
+  return p & ~1;
+}
+
+} // namespace
+
+void OSD::hideImagefileSlot() {
+  ImagefileSlot &s = img_slot_;
+  if (s.region_created && s.shown) {
+    IMP_OSD_ShowRgn(s.rgn, osdGrp, 0);
+    s.shown = false;
+  }
+}
+
+void OSD::destroyImagefileSlot() {
+  ImagefileSlot &s = img_slot_;
+  if (s.region_created) {
+    IMP_OSD_ShowRgn(s.rgn, osdGrp, 0);
+    IMP_OSD_UnRegisterRgn(s.rgn, osdGrp);
+    IMP_OSD_DestroyRgn(s.rgn);
+  }
+  s = ImagefileSlot{};
+}
+
+bool OSD::reloadImagefile(const std::string &path, size_t bytes, bool force,
+                          bool &present) {
+  ImagefileSlot &s = img_slot_;
+  struct stat st;
+  if (stat(path.c_str(), &st) != 0 || !S_ISREG(st.st_mode)) {
+    present = false;
+    bool changed = !s.buf.empty();
+    s.buf.clear();
+    s.file_seen = false;
+    s.size_warned = false;
+    return changed;
+  }
+  if (!force && s.file_seen && st.st_ino == s.file_ino &&
+      st.st_size == s.file_size && st.st_mtim.tv_sec == s.file_mtime.tv_sec &&
+      st.st_mtim.tv_nsec == s.file_mtime.tv_nsec) {
+    present = !s.buf.empty();
+    return false;
+  }
+
+  int fd = open(path.c_str(), O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+  if (fd < 0) {
+    present = !s.buf.empty();
+    return false;
+  }
+  // The identity of the file actually opened (a rename may have replaced
+  // the one stat()ed above).
+  if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode)) {
+    close(fd);
+    present = !s.buf.empty();
+    return false;
+  }
+  s.file_seen = true;
+  s.file_ino = st.st_ino;
+  s.file_size = st.st_size;
+  s.file_mtime = st.st_mtim;
+
+  if (st.st_size == 0) {
+    // An empty file hides the overlay, like an empty text file
+    close(fd);
+    present = false;
+    bool changed = !s.buf.empty();
+    s.buf.clear();
+    s.size_warned = false;
+    return changed;
+  }
+  if ((size_t)st.st_size != bytes) {
+    close(fd);
+    if (!s.size_warned)
+      LOG_WARN("OSD: imagefile " << path << " is " << st.st_size
+               << " bytes, expected " << bytes << " (osd.imagefile.width x height x 4 BGRA)"
+               " - not shown");
+    s.size_warned = true;
+    present = false;
+    bool changed = !s.buf.empty();
+    s.buf.clear();
+    return changed;
+  }
+  s.size_warned = false;
+
+  std::vector<uint8_t> data(bytes);
+  size_t got = 0;
+  bool read_ok = true;
+  while (got < bytes) {
+    ssize_t n = read(fd, data.data() + got, bytes - got);
+    if (n > 0) {
+      got += (size_t)n;
+    } else if (n == 0) {
+      break;
+    } else if (errno != EINTR) {
+      read_ok = false;
+      break;
+    }
+  }
+  close(fd);
+  if (!read_ok || got != bytes) {
+    // Try again next tick; keep showing what we have
+    s.file_seen = false;
+    present = !s.buf.empty();
+    return false;
+  }
+  present = true;
+  if (data == s.buf)
+    return false;
+  s.buf = std::move(data);
+  return true;
+}
+
+void OSD::updateImagefileOverlay(size_t budget, bool once_per_second, bool release_only) {
+  ImagefileSlot &s = img_slot_;
+  const _osd_imagefile &c = cfg->osd.imagefile;
+  const bool enabled = c.enabled && !(is_substream_ && c.substream_disabled);
+  if (!enabled) {
+    destroyImagefileSlot();
+    return;
+  }
+  if (once_per_second || !s.conf_valid) {
+    std::lock_guard<std::mutex> lk(cfg->stringMutex);
+    s.conf_path = c.path ? c.path : "";
+    s.conf_valid = true;
+  }
+  const std::string &path = s.conf_path;
+  // Validated on the way in (even, within the maximum); clamp anyway
+  const int width = std::clamp(c.width & ~1, 2, kImagefileMaxWidth);
+  const int height = std::clamp(c.height & ~1, 2, kImagefileMaxHeight);
+  const size_t bytes = (size_t)width * height * 4;
+
+  if (width > stream_width || height > stream_height) {
+    if (!s.too_big) {
+      LOG_WARN("OSD: imagefile overlay " << width << "x" << height
+               << " is larger than the " << stream_width << "x" << stream_height
+               << " frame - not shown");
+      destroyImagefileSlot(); // once: destroy resets the slot (and conf_valid)
+      s.too_big = true;
+    }
+    return;
+  }
+  s.too_big = false;
+  if (bytes > budget) {
+    // Not shrunk: a cut-off picture is useless. Released so the text slots
+    // keep their room; recreated once it fits (bigger pool, smaller text).
+    if (!s.over_budget) {
+      LOG_WARN("OSD: imagefile overlay " << width << "x" << height << " ("
+               << (bytes / 1024) << " KB) not shown: only " << (budget / 1024)
+               << " KB of the OSD pool left after the text overlays "
+                  "(see general.osd_pool_size)");
+      destroyImagefileSlot(); // once, see above
+      s.over_budget = true;
+    }
+    return;
+  }
+  s.over_budget = false;
+  if (release_only) {
+    // A region of another size is given up now too, so that the text slots
+    // never grow while the old picture still holds its memory; the second
+    // call creates it again at the new size.
+    if (s.region_created && (width != s.width || height != s.height))
+      destroyImagefileSlot();
+    return;
+  }
+
+  const int x = resolveImagePos(c.pos_x, width, stream_width);
+  const int y = resolveImagePos(c.pos_y, height, stream_height);
+  const bool geometry_changed = width != s.width || height != s.height;
+  const bool moved = x != s.x || y != s.y;
+  const bool path_changed = path != s.path;
+  if (geometry_changed || moved)
+    s.failed = false; // a new geometry or position is worth another attempt
+  bool present = false;
+  if (reloadImagefile(path, bytes, path_changed || geometry_changed, present))
+    s.pending = true; // new pixels, not handed to libimp yet
+  s.path = path;
+
+  if (!present || s.failed) {
+    hideImagefileSlot();
+    return;
+  }
+
+  if (!s.region_created) {
+    s.rgn = IMP_OSD_CreateRgn(nullptr);
+    if (s.rgn == INVHANDLE) {
+      if (!s.create_error_logged)
+        LOG_ERROR("OSD: IMP_OSD_CreateRgn failed for imagefile overlay");
+      s.create_error_logged = true;
+      return;
+    }
+    if (IMP_OSD_RegisterRgn(s.rgn, osdGrp, nullptr) != 0) {
+      // Retried next tick with a fresh handle
+      if (!s.create_error_logged)
+        LOG_ERROR("OSD: IMP_OSD_RegisterRgn failed for imagefile overlay");
+      s.create_error_logged = true;
+      IMP_OSD_DestroyRgn(s.rgn);
+      s.rgn = INVHANDLE;
+      return;
+    }
+    s.create_error_logged = false;
+    s.region_created = true;
+  }
+
+  const bool attr_stale = !s.attr_set || geometry_changed || moved;
+  if (attr_stale) {
+    memset(&s.attr, 0, sizeof(s.attr));
+    s.attr.type = OSD_REG_PIC;
+    s.attr.fmt = PIX_FMT_BGRA;
+    s.attr.rect.p0.x = x;
+    s.attr.rect.p0.y = y;
+    s.attr.rect.p1.x = x + width - 1;
+    s.attr.rect.p1.y = y + height - 1;
+    s.attr.data.picData.pData = s.buf.data();
+    int ret = IMP_OSD_SetRgnAttr(s.rgn, &s.attr);
+    if (ret != 0) {
+      LOG_ERROR("OSD: IMP_OSD_SetRgnAttr failed (" << ret << ") for imagefile overlay "
+                << width << "x" << height << " (" << (bytes / 1024)
+                << " KB); reduce osd.imagefile.width/height or raise general.osd_pool_size");
+      s.failed = true;
+      s.attr_set = false;
+      hideImagefileSlot();
+      return;
+    }
+    if (!s.attr_set) {
+      IMPOSDGrpRgnAttr grp;
+      memset(&grp, 0, sizeof(grp));
+      grp.show = 1;
+      grp.layer = 3 + kTextfileSlots; // above the text overlays
+      grp.gAlphaEn = 1;               // per-pixel alpha from the file
+      grp.fgAlhpa = 255;
+      grp.bgAlhpa = 0;
+      if (IMP_OSD_SetGrpRgnAttr(s.rgn, osdGrp, &grp) != 0) {
+        // The region exists but is not in the group's display list: try
+        // the whole attribute step again next tick
+        LOG_ERROR("OSD: IMP_OSD_SetGrpRgnAttr failed for imagefile overlay");
+        return;
+      }
+      if (!osd_group_started_) {
+        IMP_OSD_Start(osdGrp);
+        osd_group_started_ = true;
+      }
+      s.shown = true;
+    }
+    s.attr_set = true;
+    s.pending = false; // SetRgnAttr took the current buffer
+    s.width = width;
+    s.height = height;
+    s.x = x;
+    s.y = y;
+    LOG_INFO("OSD: imagefile overlay " << width << "x" << height << " at " << x << ","
+             << y << " (" << (bytes / 1024) << " KB) from " << path);
+  } else if (s.pending) {
+    s.attr.data.picData.pData = s.buf.data();
+    if (IMP_OSD_UpdateRgnAttrData(s.rgn, &s.attr.data) == 0)
+      s.pending = false; // else: still pending, tried again next tick
+    else
+      LOG_ERROR("OSD: IMP_OSD_UpdateRgnAttrData failed for imagefile overlay, retrying");
+  }
+
+  if (!s.shown) {
+    if (IMP_OSD_ShowRgn(s.rgn, osdGrp, 1) == 0)
+      s.shown = true;
+  }
+}
+
+#endif // OSD_BURN_TIMESTAMP
diff --git a/src/video/OSDTextRender.hpp b/src/video/OSDTextRender.hpp
new file mode 100644
index 0000000..ea05235
--- /dev/null
+++ b/src/video/OSDTextRender.hpp
@@ -0,0 +1,222 @@
+#pragma once
+// -- text-file overlay: layout + rasterizer ---------------------------
+// Pure helpers for OSD::updateTextfileOverlay() (OSDTextfile.cpp). No IMP
+// or config dependencies, so this header can be compiled and tested on a
+// host machine. Uses the same build-time bitmap font as the timestamp
+// overlay (util/OSDFont.hpp); the libschrift build falls back to the
+// bitmap font here because a fixed cell grid is what ASCII art needs.
+
+#include "util/OSDFont.hpp"
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+namespace osdtext {
+
+// One row of text, decoded to codepoints (one cell per codepoint).
+using Line = std::vector<uint32_t>;
+
+struct Layout {
+  int scale{1};
+  int cols{1};
+  int rows{1};
+  int width{0};  // region size in pixels (both even)
+  int height{0};
+
+  bool operator==(const Layout &o) const {
+    return scale == o.scale && cols == o.cols && rows == o.rows;
+  }
+  bool operator!=(const Layout &o) const { return !(*this == o); }
+};
+
+struct Colors {
+  uint8_t fill[4]{255, 255, 255, 255}; // B, G, R, A
+  uint8_t outline[4]{0, 0, 0, 0};      // alpha 0 = no outline
+  uint8_t background[4]{0, 0, 0, 128}; // alpha 0 = no background box
+};
+
+// Cell size in font pixels. 8-pixel-wide fonts already carry their own
+// inter-glyph spacing (and bars like "####" should tile seamlessly); the
+// 5x7 font needs a spacing column. Fonts up to 8 rows tall use the full
+// glyph height (descenders), so they get one row of leading; the 8x16
+// Unifont has its leading built in.
+constexpr int kCellW = osdfont::WIDTH >= 8 ? osdfont::WIDTH : osdfont::WIDTH + 1;
+constexpr int kCellH = osdfont::HEIGHT <= 8 ? osdfont::HEIGHT + 1 : osdfont::HEIGHT;
+
+inline int padding(int scale) { return scale * 2; }
+
+inline Layout makeLayout(int scale, int cols, int rows) {
+  Layout l;
+  l.scale = scale;
+  l.cols = cols;
+  l.rows = rows;
+  l.width = cols * kCellW * scale + padding(scale) * 2;
+  l.height = rows * kCellH * scale + padding(scale) * 2;
+  l.width += l.width & 1; // IMP regions expect even dimensions
+  l.height += l.height & 1;
+  return l;
+}
+
+inline size_t layoutBytes(const Layout &l) {
+  return (size_t)l.width * l.height * 4;
+}
+
+// Largest layout not exceeding the requested one that fits in a
+// maxW x maxH frame and in maxBytes of BGRA: shrink the scale first, then
+// the grid (columns for width, rows for height and bytes).
+inline Layout fitLayout(int scale, int cols, int rows, int maxW, int maxH,
+                        size_t maxBytes) {
+  Layout l = makeLayout(scale, cols, rows);
+  auto tooBig = [&]() {
+    return l.width > maxW || l.height > maxH || layoutBytes(l) > maxBytes;
+  };
+  while (tooBig() && scale > 1)
+    l = makeLayout(--scale, cols, rows);
+  while (l.width > maxW && cols > 1)
+    l = makeLayout(scale, --cols, rows);
+  while ((l.height > maxH || layoutBytes(l) > maxBytes) && rows > 1)
+    l = makeLayout(scale, cols, --rows);
+  while (layoutBytes(l) > maxBytes && cols > 1)
+    l = makeLayout(scale, --cols, rows);
+  return l;
+}
+
+// Split raw file bytes into at most `rows` lines of at most `cols` cells.
+// Accepts LF or CRLF, decodes UTF-8 (one cell per codepoint; bytes that are
+// not valid UTF-8 become one blank each), expands nothing: tabs and other
+// control characters become blanks. Trailing
+// blank lines are dropped, so an empty or whitespace-only file yields an
+// empty vector (= overlay hidden).
+inline std::vector<Line> parseLines(const char *data, size_t len, int cols,
+                                    int rows) {
+  std::vector<Line> lines;
+  Line cur;
+  auto flush = [&]() {
+    if ((int)lines.size() < rows)
+      lines.push_back(cur);
+    cur.clear();
+  };
+  size_t i = 0;
+  while (i < len && (int)lines.size() < rows) {
+    unsigned char c = (unsigned char)data[i];
+    uint32_t cp;
+    size_t n = 1;
+    // Continuation byte (10xxxxxx) at offset k of the current sequence?
+    auto cont = [&](size_t k) {
+      return i + k < len && ((unsigned char)data[i + k] & 0xC0) == 0x80;
+    };
+    if (c < 0x80) {
+      cp = c;
+    } else if ((c & 0xE0) == 0xC0 && cont(1)) {
+      cp = ((uint32_t)(c & 0x1F) << 6) | (uint32_t)(data[i + 1] & 0x3F);
+      n = 2;
+    } else if ((c & 0xF0) == 0xE0 && cont(1) && cont(2)) {
+      cp = ((uint32_t)(c & 0x0F) << 12) | ((uint32_t)(data[i + 1] & 0x3F) << 6) |
+           (uint32_t)(data[i + 2] & 0x3F);
+      n = 3;
+    } else if ((c & 0xF8) == 0xF0 && cont(1) && cont(2) && cont(3)) {
+      cp = ((uint32_t)(c & 0x07) << 18) | ((uint32_t)(data[i + 1] & 0x3F) << 12) |
+           ((uint32_t)(data[i + 2] & 0x3F) << 6) | (uint32_t)(data[i + 3] & 0x3F);
+      n = 4;
+    } else {
+      // Not valid UTF-8 (Shift_JIS, Latin-1, a truncated sequence...): blank
+      // this one byte only, so that a following newline is never swallowed.
+      cp = ' ';
+    }
+    i += n;
+    if (cp == '\n') {
+      flush();
+      continue;
+    }
+    if (cp == '\r')
+      continue;
+    if (cp < 0x20 || cp == 0x7F)
+      cp = ' ';
+    if ((int)cur.size() < cols)
+      cur.push_back(cp);
+  }
+  if (!cur.empty())
+    flush();
+  auto blank = [](const Line &l) {
+    for (uint32_t cp : l)
+      if (cp != ' ')
+        return false;
+    return true;
+  };
+  while (!lines.empty() && blank(lines.back()))
+    lines.pop_back();
+  return lines;
+}
+
+// Rasterize `lines` into a BGRA buffer of layout.width x layout.height.
+// Colors are written as-is (no blending inside the buffer): background
+// first, then the outline (each glyph pixel dilated by max(1, scale/2) px
+// as a square), then the fill. The per-pixel alpha is applied by the IMP
+// OSD when it composites the region onto the frame.
+inline void render(const std::vector<Line> &lines, const Layout &l,
+                   const Colors &c, std::vector<uint8_t> &buf) {
+  const int w = l.width, h = l.height, scale = l.scale;
+  buf.resize((size_t)w * h * 4);
+  uint8_t *img = buf.data();
+
+  if (c.background[3] == 0) {
+    memset(img, 0, buf.size());
+  } else {
+    for (int i = 0; i < w; ++i)
+      memcpy(img + i * 4, c.background, 4);
+    for (int y = 1; y < h; ++y)
+      memcpy(img + (size_t)y * w * 4, img, (size_t)w * 4);
+  }
+
+  auto fillRect = [&](int x0, int y0, int x1, int y1, const uint8_t *color) {
+    if (x0 < 0) x0 = 0;
+    if (y0 < 0) y0 = 0;
+    if (x1 > w) x1 = w;
+    if (y1 > h) y1 = h;
+    for (int y = y0; y < y1; ++y) {
+      uint8_t *p = img + ((size_t)y * w + x0) * 4;
+      for (int x = x0; x < x1; ++x, p += 4)
+        memcpy(p, color, 4);
+    }
+  };
+
+  const int pad = padding(scale);
+  auto pass = [&](const uint8_t *color, int grow) {
+    int row = 0;
+    for (const Line &line : lines) {
+      if (row >= l.rows)
+        break;
+      const int oy = pad + row * kCellH * scale;
+      int col = 0;
+      for (uint32_t cp : line) {
+        if (col >= l.cols)
+          break;
+        const uint8_t *g = osdfont::glyphForCp(cp);
+        if (g) {
+          const int ox = pad + col * kCellW * scale;
+          for (int ry = 0; ry < osdfont::HEIGHT; ++ry) {
+            const uint8_t bits = g[ry];
+            if (!bits)
+              continue;
+            for (int rx = 0; rx < osdfont::WIDTH; ++rx) {
+              if (bits & osdfont::columnMask(rx)) {
+                const int x = ox + rx * scale, y = oy + ry * scale;
+                fillRect(x - grow, y - grow, x + scale + grow, y + scale + grow,
+                         color);
+              }
+            }
+          }
+        }
+        ++col;
+      }
+      ++row;
+    }
+  };
+
+  if (c.outline[3] != 0)
+    pass(c.outline, scale / 2 > 1 ? scale / 2 : 1);
+  if (c.fill[3] != 0)
+    pass(c.fill, 0);
+}
+
+} // namespace osdtext
