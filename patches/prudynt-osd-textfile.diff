new file mode 100644
index 0000000..789fee0
--- /dev/null
+++ b/src/video/OSDTextfile.cpp
@@ -0,0 +1,424 @@
+// -- text-file overlay --------------------------------------------------
+// Extra burned-in OSD regions ("slots": osd.textfile, osd.textfile2,
+// osd.textfile3) that each show the contents of a text file (the slot's
+// path, meant to live on tmpfs). Another program updates an overlay by
+// replacing its file (write a temp file, then rename); this code polls the
+// file's identity/mtime on every OSD thread tick (100 ms) and re-renders
+// only when the contents or the settings changed.
+//
+// Kept apart from the timestamp overlay (renderTimestamp() /
+// updateTimestampOverlay() in OSD.cpp) on purpose: own region, own buffer,
+// own renderer. An empty or missing file hides the region; disabling a
+// slot destroys its region so that its share of the OSD pool is released.
+
+#ifdef OSD_BURN_TIMESTAMP
+
+#include "video/OSD.hpp"
+#include "video/OSDTextRender.hpp"
+#include "config/Config.hpp"
+#include "util/Logger.hpp"
+#include <algorithm>
+#include <cerrno>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace {
+
+// Upper bound on the bytes read from the text file: the largest grid
+// (kTextfileMaxCols x kTextfileMaxRows) of 4-byte UTF-8 plus line ends.
+constexpr size_t kMaxFileBytes =
+    (size_t)kTextfileMaxRows * (kTextfileMaxCols * 4 + 2);
+
+// Bytes of the IMP OSD pool this overlay may use. libimp gives no error when
+// a region does not fit in the pool -- IMP_OSD_SetRgnAttr() returns 0 and the
+// region just never shows up (seen on T31: with the 616 KB pool of a 720p
+// stream a 562 KB region works, a 660 KB one silently disappears) -- so the
+// size has to be limited up front. Mirrors the pool size set in
+// IMPSystem.cpp, minus this stream's timestamp region (`used`, which can be
+// most of the pool at osd.burnin.scale 10) and a fixed reserve for the
+// regions of the other stream's OSD, which this object cannot see. The
+// result is shared by this stream's slots in slot order (see
+// updateTextfileOverlay()).
+size_t textfilePoolBudget(size_t used) {
+  const size_t kReservedBytes = 48 * 1024 + used;
+  size_t pool_kb;
+  if (cfg->general.osd_pool_size > 0) {
+    pool_kb = (size_t)cfg->general.osd_pool_size;
+  } else {
+    int max_pixels = 0;
+    for (auto *s : {&cfg->stream0, &cfg->stream1, &cfg->stream2, &cfg->stream3})
+      if (s->enabled)
+        max_pixels = std::max(max_pixels, s->width * s->height);
+    pool_kb = (size_t)((max_pixels * 4 * 0.1) / 1024 + 256);
+  }
+  size_t bytes = pool_kb * 1024;
+  bytes = bytes > kReservedBytes ? bytes - kReservedBytes : 0;
+  // With overlays on both streams, two OSD objects size their regions
+  // independently out of the same pool: give each one half.
+  const bool on_substream =
+      (cfg->osd.textfile.enabled && !cfg->osd.textfile.substream_disabled) ||
+      (cfg->osd.textfile2.enabled && !cfg->osd.textfile2.substream_disabled) ||
+      (cfg->osd.textfile3.enabled && !cfg->osd.textfile3.substream_disabled) ||
+      (cfg->osd.imagefile.enabled && !cfg->osd.imagefile.substream_disabled);
+  if (on_substream && cfg->stream1.enabled)
+    bytes /= 2;
+  return bytes;
+}
+
+// "#RRGGBBAA" -> B, G, R, A. Leaves `bgra` untouched on malformed input.
+void parseColor(const char *hex, uint8_t bgra[4]) {
+  if (!hex || hex[0] != '#' || strlen(hex) != 9)
+    return;
+  int v[8];
+  for (int i = 0; i < 8; ++i) {
+    char ch = hex[i + 1];
+    if (ch >= '0' && ch <= '9') v[i] = ch - '0';
+    else if (ch >= 'a' && ch <= 'f') v[i] = ch - 'a' + 10;
+    else if (ch >= 'A' && ch <= 'F') v[i] = ch - 'A' + 10;
+    else return;
+  }
+  bgra[0] = (uint8_t)(v[4] << 4 | v[5]);
+  bgra[1] = (uint8_t)(v[2] << 4 | v[3]);
+  bgra[2] = (uint8_t)(v[0] << 4 | v[1]);
+  bgra[3] = (uint8_t)(v[6] << 4 | v[7]);
+}
+
+// pos >= 0: distance of the region's near edge from the left/top.
+// pos <  0: distance of the region's far edge from the right/bottom.
+// Clamped into the frame and rounded down to an even pixel.
+int resolvePos(int pos, int size, int frame) {
+  int p = pos >= 0 ? pos : frame + pos - size;
+  p = std::clamp(p, 0, std::max(0, frame - size));
+  return p & ~1;
+}
+
+const char *slotName(int i) {
+  static const char *const names[kTextfileSlots] = {"textfile", "textfile2",
+                                                     "textfile3"};
+  return names[i];
+}
+
+} // namespace
+
+// What a slot should look like on this tick, from its settings and the pool
+// budget left over by the slots before it.
+struct OSD::TextfilePlan {
+  bool enabled{false};
+  bool reduced{false}; // layout is smaller than the settings ask for
+  bool over_budget{false}; // not even the smallest grid fits
+  std::string path;
+  int scale{1}, cols{1}, rows{1}; // as configured
+  size_t budget{0};
+  osdtext::Layout layout;
+  int x{0}, y{0};
+  osdtext::Colors colors;
+};
+
+void OSD::hideTextfileSlot(TextfileSlot &s) {
+  if (s.region_created && s.shown) {
+    IMP_OSD_ShowRgn(s.rgn, osdGrp, 0);
+    s.shown = false;
+  }
+}
+
+void OSD::destroyTextfileSlot(TextfileSlot &s) {
+  if (s.region_created) {
+    IMP_OSD_ShowRgn(s.rgn, osdGrp, 0);
+    IMP_OSD_UnRegisterRgn(s.rgn, osdGrp);
+    IMP_OSD_DestroyRgn(s.rgn);
+  }
+  // Back to the initial state: the next enable starts from scratch.
+  s = TextfileSlot{};
+}
+
+void OSD::destroyTextfileOverlays() {
+  for (auto &s : tf_slots_)
+    destroyTextfileSlot(s);
+}
+
+// Reload s.lines from the file if its identity or mtime changed.
+// Returns true when the parsed text differs from what was loaded before.
+bool OSD::reloadTextfile(TextfileSlot &s, const std::string &path, int cols, int rows,
+                         bool force) {
+  struct stat st;
+  if (stat(path.c_str(), &st) != 0 || !S_ISREG(st.st_mode)) {
+    bool changed = !s.lines.empty();
+    s.lines.clear();
+    s.file_seen = false;
+    return changed;
+  }
+  if (!force && s.file_seen && st.st_ino == s.file_ino &&
+      st.st_size == s.file_size && st.st_mtim.tv_sec == s.file_mtime.tv_sec &&
+      st.st_mtim.tv_nsec == s.file_mtime.tv_nsec)
+    return false;
+
+  // Any failure below leaves the remembered identity alone, so the next
+  // tick simply tries again.
+  int fd = open(path.c_str(), O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+  if (fd < 0)
+    return false;
+  // Record the identity of the file actually opened, not of the one
+  // stat()ed above: a rename may have replaced it in between.
+  if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode)) {
+    close(fd);
+    return false;
+  }
+  std::vector<char> data(kMaxFileBytes);
+  size_t got = 0;
+  bool read_ok = true;
+  while (got < data.size()) {
+    ssize_t n = read(fd, data.data() + got, data.size() - got);
+    if (n > 0) {
+      got += (size_t)n;
+    } else if (n == 0) {
+      break;
+    } else if (errno != EINTR) {
+      read_ok = false;
+      break;
+    }
+  }
+  close(fd);
+  if (!read_ok)
+    return false;
+  std::vector<osdtext::Line> lines =
+      osdtext::parseLines(data.data(), got, cols, rows);
+  s.file_seen = true;
+  s.file_ino = st.st_ino;
+  s.file_size = st.st_size;
+  s.file_mtime = st.st_mtim;
+
+  if (lines == s.lines)
+    return false;
+  s.lines = std::move(lines);
+  return true;
+}
+
+void OSD::updateTextfileOverlay(bool once_per_second) {
+  if (!cfg)
+    return;
+  const _osd_textfile *conf[kTextfileSlots] = {
+      &cfg->osd.textfile, &cfg->osd.textfile2, &cfg->osd.textfile3};
+
+  // Pass 1: decide every slot's geometry. Each region is always allocated
+  // at its full cols x rows size, so that a text update is only an
+  // IMP_OSD_UpdateRgnAttrData() (no reallocation). The pool budget is handed
+  // out in slot order: an enabled slot keeps its share even while its file
+  // is empty, and later slots shrink to what is left.
+  const size_t ts_bytes =
+      ts_region_created_ ? (size_t)ts_width_ * ts_height_ * 4 : 0;
+  size_t remaining = textfilePoolBudget(ts_bytes);
+  TextfilePlan plans[kTextfileSlots];
+  for (int i = 0; i < kTextfileSlots; ++i) {
+    const _osd_textfile &c = *conf[i];
+    TextfilePlan &p = plans[i];
+    p.enabled = c.enabled && !(is_substream_ && c.substream_disabled);
+    if (!p.enabled)
+      continue;
+    // Snapshot the settings; everything below works on the copies. The
+    // string settings are plain pointers that the JSON API thread frees and
+    // replaces: copy them out under the lock that set<const char *>() holds
+    // while doing so, and only once per second rather than on every tick.
+    TextfileSlot &s = tf_slots_[i];
+    if (once_per_second || !s.conf_valid) {
+      std::lock_guard<std::mutex> lk(cfg->stringMutex);
+      s.conf_path = c.path ? c.path : "";
+      s.conf_colors = osdtext::Colors{};
+      parseColor(c.fill_color, s.conf_colors.fill);
+      parseColor(c.outline_color, s.conf_colors.outline);
+      parseColor(c.background_color, s.conf_colors.background);
+      s.conf_valid = true;
+    }
+    p.path = s.conf_path;
+    p.colors = s.conf_colors;
+    p.scale = c.scale > 0 ? c.scale : stream_width / 480; // auto: as osd.burnin.scale
+    p.scale = std::clamp(p.scale, 1, kBurninMaxScale);
+    p.cols = std::clamp(c.cols, 1, kTextfileMaxCols);
+    p.rows = std::clamp(c.rows, 1, kTextfileMaxRows);
+    p.budget = remaining;
+    p.layout = osdtext::fitLayout(p.scale, p.cols, p.rows, stream_width,
+                                  stream_height, remaining);
+    p.over_budget = osdtext::layoutBytes(p.layout) > remaining;
+    p.reduced = p.layout.scale != p.scale || p.layout.cols != p.cols ||
+                p.layout.rows != p.rows;
+    if (!p.over_budget)
+      remaining -= osdtext::layoutBytes(p.layout);
+    p.x = resolvePos(c.pos_x, p.layout.width, stream_width);
+    p.y = resolvePos(c.pos_y, p.layout.height, stream_height);
+  }
+
+  // The image overlay is planned last (it gets what the text slots leave)
+  // but must give its pool memory up first, before any text slot grows into
+  // that room. Created / updated after pass 2 (second call below).
+  updateImagefileOverlay(remaining, once_per_second, true);
+
+  // Pass 2: apply. Slots that release pool memory (disabled, or shrinking)
+  // go first, so that the ones that grow find the room they were promised.
+  for (int pass = 0; pass < 2; ++pass) {
+    for (int i = 0; i < kTextfileSlots; ++i) {
+      TextfileSlot &s = tf_slots_[i];
+      const size_t have = s.attr_set ? osdtext::layoutBytes(s.attr_layout) : 0;
+      const bool grows =
+          plans[i].enabled && osdtext::layoutBytes(plans[i].layout) > have;
+      if (grows == (pass == 1))
+        applyTextfileSlot(i, plans[i]);
+    }
+  }
+
+  // The image overlay comes last: it gets what the text slots left, and is
+  // not shrunk to fit (a cut-off picture is of no use) - see OSDImagefile.cpp.
+  updateImagefileOverlay(remaining, once_per_second, false);
+
+  // The timestamp region changed size (osd.burnin.scale, or it was just
+  // created): upstream set its new size before the slots above gave way, and
+  // a region that did not fit at that moment stays invisible without any
+  // error. Now that there is room, set its attributes once more.
+  if (ts_bytes != tf_ts_bytes_) {
+    bool any = img_slot_.attr_set;
+    for (const auto &s : tf_slots_)
+      any = any || s.attr_set;
+    if (any && ts_region_created_ && !ts_buf_.empty()) {
+      ts_attr_.data.picData.pData = ts_buf_.data();
+      IMP_OSD_SetRgnAttr(ts_rgn_, &ts_attr_);
+    }
+    tf_ts_bytes_ = ts_bytes;
+  }
+}
+
+void OSD::applyTextfileSlot(int index, const TextfilePlan &plan) {
+  TextfileSlot &s = tf_slots_[index];
+  if (!plan.enabled) {
+    destroyTextfileSlot(s);
+    return;
+  }
+  if (plan.over_budget) {
+    // The planner gave this slot no pool memory, so it must not keep any:
+    // hiding the region would leave its old allocation in place and starve
+    // the slots that were promised that room. Recreated once it fits again.
+    if (!s.over_budget)
+      LOG_WARN("OSD: " << slotName(index) << " overlay not shown: only "
+               << (plan.budget / 1024) << " KB of the OSD pool left for it "
+               "(see general.osd_pool_size)");
+    destroyTextfileSlot(s);
+    s.over_budget = true;
+    return;
+  }
+  s.over_budget = false;
+
+  const osdtext::Layout &layout = plan.layout;
+  const osdtext::Colors &colors = plan.colors;
+  const std::string &path = plan.path;
+  const int x = plan.x, y = plan.y;
+
+  const bool layout_changed = layout != s.layout;
+  const bool colors_changed = memcmp(&colors, &s.colors, sizeof(colors)) != 0;
+  const bool path_changed = path != s.path;
+  if (layout_changed) {
+    s.failed = false; // new geometry: worth another attempt
+    if (plan.reduced)
+      LOG_WARN("OSD: " << slotName(index) << " overlay (scale " << plan.scale
+               << ", " << plan.cols << "x" << plan.rows
+               << " cells) does not fit the " << stream_width << "x"
+               << stream_height << " frame or the OSD pool ("
+               << (plan.budget / 1024) << " KB left for it, see "
+               "general.osd_pool_size); reduced to scale " << layout.scale
+               << ", " << layout.cols << "x" << layout.rows << " cells");
+  }
+  const bool text_changed = reloadTextfile(s, path, layout.cols, layout.rows,
+                                           path_changed || layout_changed);
+  s.path = path;
+  s.layout = layout;
+  s.colors = colors;
+  // Sticky across ticks: changes that arrive while the overlay is hidden
+  // (empty file) must still be rendered once it is shown again.
+  s.dirty = s.dirty || layout_changed || colors_changed || text_changed;
+
+  if (s.lines.empty() || s.failed) {
+    hideTextfileSlot(s);
+    return;
+  }
+
+  const bool rendered = s.dirty || s.buf.empty();
+  if (rendered) {
+    osdtext::render(s.lines, layout, colors, s.buf);
+    s.dirty = false;
+  }
+
+  if (!s.region_created) {
+    // Like the timestamp overlay, the region can only be registered once
+    // IMPEncoder has created the OSD group, i.e. from the periodic update.
+    s.rgn = IMP_OSD_CreateRgn(nullptr);
+    if (s.rgn == INVHANDLE) {
+      // Retried on the next tick (the OSD group may not be up yet).
+      if (!s.create_error_logged)
+        LOG_ERROR("OSD: IMP_OSD_CreateRgn failed for " << slotName(index) << " overlay");
+      s.create_error_logged = true;
+      return;
+    }
+    s.create_error_logged = false;
+    IMP_OSD_RegisterRgn(s.rgn, osdGrp, nullptr);
+    s.region_created = true;
+  }
+
+  // Geometry the region currently has vs. the one wanted now.
+  const bool attr_stale = !s.attr_set || s.attr_layout != layout ||
+                          s.attr_x != x || s.attr_y != y;
+  if (rendered || attr_stale) {
+    if (attr_stale) {
+      memset(&s.attr, 0, sizeof(s.attr));
+      s.attr.type = OSD_REG_PIC;
+      s.attr.fmt = PIX_FMT_BGRA;
+      s.attr.rect.p0.x = x;
+      s.attr.rect.p0.y = y;
+      s.attr.rect.p1.x = x + layout.width - 1;
+      s.attr.rect.p1.y = y + layout.height - 1;
+      s.attr.data.picData.pData = s.buf.data();
+      int ret = IMP_OSD_SetRgnAttr(s.rgn, &s.attr);
+      if (ret != 0) {
+        // Most likely the OSD pool is too small for this region; see
+        // general.osd_pool_size. Do not retry until the geometry changes.
+        LOG_ERROR("OSD: IMP_OSD_SetRgnAttr failed (" << ret
+                  << ") for " << slotName(index) << " overlay " << layout.width << "x"
+                  << layout.height << " (" << (layout.width * layout.height * 4 / 1024)
+                  << " KB); reduce osd.textfile.scale/cols/rows or raise "
+                     "general.osd_pool_size");
+        s.failed = true;
+        s.attr_set = false;
+        hideTextfileSlot(s);
+        return;
+      }
+      if (!s.attr_set) {
+        IMPOSDGrpRgnAttr grp;
+        memset(&grp, 0, sizeof(grp));
+        grp.show = 1;
+        grp.layer = 3 + index; // above the privacy cover (1) and the timestamp (2)
+        grp.gAlphaEn = 1; // per-pixel alpha blending
+        grp.fgAlhpa = 255;
+        grp.bgAlhpa = 0;
+        IMP_OSD_SetGrpRgnAttr(s.rgn, osdGrp, &grp);
+        if (!osd_group_started_) {
+          IMP_OSD_Start(osdGrp);
+          osd_group_started_ = true;
+        }
+        s.shown = true;
+      }
+      s.attr_set = true;
+      s.attr_layout = layout;
+      s.attr_x = x;
+      s.attr_y = y;
+      LOG_INFO("OSD: " << slotName(index) << " overlay " << layout.width << "x" << layout.height
+               << " at " << x << "," << y << " (scale " << layout.scale << ", "
+               << layout.cols << "x" << layout.rows << " cells)");
+    } else {
+      s.attr.data.picData.pData = s.buf.data();
+      IMP_OSD_UpdateRgnAttrData(s.rgn, &s.attr.data);
+    }
+  }
+
+  if (!s.shown) {
+    IMP_OSD_ShowRgn(s.rgn, osdGrp, 1);
+    s.shown = true;
+  }
+}
