 /**
+ * Announce a bigger chunk size for our outgoing packets and switch to it.
+ *
+ * FFmpeg keeps the default 128-byte chunks for everything it publishes, and
+ * ff_rtmp_packet_write() issues a separate write for every chunk (plus one for
+ * the 1-byte continuation header). Over TLS each write becomes its own record
+ * (~29 bytes of framing), so a 128-byte chunk costs about 60 bytes on top of
+ * itself, and the many small writes also inflate the TCP/IP header share. With
+ * 1 Mbps of H.264 to rtmps://a.rtmps.youtube.com this made the wire rate 1.7x
+ * the media rate. Sending Set Chunk Size right after the handshake brings it
+ * back to a few percent.
+ */
+static int gen_set_chunk_size(URLContext *s, RTMPContext *rt)
+{
+    RTMPPacket pkt;
+    uint8_t *p;
+    int ret;
+
+    if (rt->chunk_size <= 128)
+        return 0;
+
+    if ((ret = ff_rtmp_packet_create(&pkt, RTMP_NETWORK_CHANNEL,
+                                     RTMP_PT_CHUNK_SIZE, 0, 4)) < 0)
+        return ret;
+
+    p = pkt.data;
+    bytestream_put_be32(&p, rt->chunk_size);
+    // This message itself still goes out in the old chunk size (it fits anyway).
+    ret = rtmp_send_packet(rt, &pkt, 0);
+    if (ret < 0)
+        return ret;
+
+    rt->out_chunk_size = rt->chunk_size;
+    av_log(s, AV_LOG_DEBUG, "Outgoing chunk size set to %d\n", rt->out_chunk_size);
+    return 0;
+}
+
+/**
  * Generate window acknowledgement size message and send it to the server.
  */
